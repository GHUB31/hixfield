# ── Required ────────────────────────────────────────────────────────────────
# Create an API key pair at https://cloud.higgsfield.ai → API Keys.
# These stay on the server. They are never sent to the browser.
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# The Higgsfield API rejects requests over your plan's concurrency cap with
# HTTP 400. Hixfield queues locally to stay under it. Default: 3
HF_MAX_CONCURRENCY=3

# Where the job database and downloaded assets live. Default: ./data
# Higgsfield's asset URLs expire after ~7 days, so every completed output is
# downloaded here immediately — the library owns its files.
DATA_DIR=./data

# Shown on the landing page. owner/repo
NEXT_PUBLIC_GITHUB_REPO=Mukhsin0508/hixfield
