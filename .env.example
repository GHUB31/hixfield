# ── Higgsfield Official API (Server-side only — never sent to browser) ───────
# Create an API key pair at https://cloud.higgsfield.ai -> API Keys.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Optional combined form (used by official higgsfield-client): key_id:key_secret
# HF_KEY=
HF_MAX_CONCURRENCY=3

# ── Supercomputer Agent Mode ─────────────────────────────────────────────────
# auto = probe official api.higgsfield.ai/v1/agent/sessions first; fallback to Vyolab orchestrator if 403/missing
# official = require official Higgsfield Supercomputer Agent API
# local = always use Vyolab's self-hosted Supercomputer orchestrator
SUPERCOMPUTER_MODE=auto

# ── ComfyUI (Colab / Cloud / Local GPU running Hugging Face models) ──────────
# Launch colab/vyolab_comfyui_worker.ipynb and paste its tunnel URL here.
COMFYUI_BASE_URL=
COMFYUI_AUTH_HEADER=Authorization
COMFYUI_AUTH_TOKEN=
COMFYUI_IMAGE_MODEL=flux1-schnell-fp8.safetensors
COMFYUI_VIDEO_MODEL=wan2.2_ti2v_5B_fp16.safetensors

# ── Hugging Face Inference Router (optional cloud fallback) ──────────────────
HUGGINGFACE_TOKEN=

# ── Server-side LLM for Vyolab Supercomputer Orchestrator (optional) ─────────
# Supports OpenAI-compatible APIs (LLM_API_URL + LLM_API_KEY + LLM_MODEL) or GEMINI_API_KEY.
# If unset, Vyolab uses its deterministic Higgsfield-skills creative planner.
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# GEMINI_API_KEY=

# ── Postiz Social Media Scheduling (requires human approval before dispatch) ─
POSTIZ_BASE_URL=http://localhost:4007
POSTIZ_API_KEY=

# ── Spend Guardrails (USD) ───────────────────────────────────────────────────
DAILY_BUDGET_USD=25
MONTHLY_BUDGET_USD=250

# ── Local Storage & Fallback ─────────────────────────────────────────────────
DATA_DIR=./data
ENABLE_LOCAL_MOTION_FALLBACK=true
NEXT_PUBLIC_GITHUB_REPO=GHUB31/hixfield
